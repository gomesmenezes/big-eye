{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@big-eye/contracts": ["packages/contracts/dist/index.d.ts"],
      "@big-eye/core/*": ["packages/core/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["**/*.test.ts", "vitest.config.ts"]
}
