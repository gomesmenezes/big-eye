generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  user
  admin
}

enum UserStatus {
  active
  suspended
}

enum CreditTxType {
  signup_bonus
  purchase
  consume
  refund
  admin_adjust
}

enum RefType {
  payment
  query
  admin
}

enum QueryMode {
  sync
  async
}

enum QueryStatus {
  pending
  running
  succeeded
  failed
  refunded
}

enum QueryEventSource {
  api
  worker
  provider
  admin
}

enum PaymentStatus {
  pending
  paid
  failed
  expired
  refunded
}

enum PaymentMethod {
  pix
  card
}

model Profile {
  id                 String              @id @db.Uuid
  email              String              @db.Text
  name               String              @default("") @db.Text
  role               Role                @default(user)
  status             UserStatus          @default(active)
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  wallet             Wallet?
  creditTransactions CreditTransaction[]
  queries            Query[]
  payments           Payment[]
  adminActions       AdminAuditLog[]     @relation("AdminActions")
  auditTargets       AdminAuditLog[]     @relation("AuditTargets")

  @@map("profiles")
}

model Wallet {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String              @unique @map("user_id") @db.Uuid
  balance   Int                 @default(0)
  updatedAt DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile   Profile             @relation(fields: [userId], references: [id], onDelete: Restrict)
  ledger    CreditTransaction[]

  @@map("wallets")
}

model CreditTransaction {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  walletId       String       @map("wallet_id") @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  type           CreditTxType
  amount         Int
  balanceAfter   Int          @map("balance_after")
  refType        RefType?     @map("ref_type")
  refId          String?      @map("ref_id") @db.Uuid
  description    String       @db.Text
  idempotencyKey String?      @unique @map("idempotency_key") @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  wallet         Wallet       @relation(fields: [walletId], references: [id], onDelete: Restrict)
  profile        Profile      @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([refType, refId, type])
  @@index([userId, createdAt])
  @@map("credit_transactions")
}

model Query {
  id                String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String       @map("user_id") @db.Uuid
  moduleSlug        String       @map("module_slug") @db.Text
  mode              QueryMode
  status            QueryStatus  @default(pending)
  creditsCharged    Int          @map("credits_charged")
  inputHash         String       @map("input_hash") @db.VarChar(64)
  inputMasked       String       @map("input_masked") @db.Text
  input             Json?
  idempotencyKey    String?      @map("idempotency_key") @db.Text
  providerRequestId String?      @map("provider_request_id") @db.Text
  attempts          Int          @default(0)
  nextPollAt        DateTime?    @map("next_poll_at") @db.Timestamptz(6)
  errorCode         String?      @map("error_code") @db.Text
  errorMessage      String?      @map("error_message") @db.Text
  startedAt         DateTime?    @map("started_at") @db.Timestamptz(6)
  finishedAt        DateTime?    @map("finished_at") @db.Timestamptz(6)
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  profile           Profile      @relation(fields: [userId], references: [id], onDelete: Restrict)
  events            QueryEvent[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt(sort: Desc)])
  @@index([status, nextPollAt])
  @@map("queries")
}

model QueryEvent {
  id         String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queryId    String           @map("query_id") @db.Uuid
  fromStatus QueryStatus?     @map("from_status")
  toStatus   QueryStatus      @map("to_status")
  source     QueryEventSource
  message    String           @db.Text
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  query      Query            @relation(fields: [queryId], references: [id], onDelete: Restrict)

  @@index([queryId, createdAt])
  @@map("query_events")
}

model CreditPackage {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug       String   @unique @db.Text
  credits    Int
  priceCents Int      @map("price_cents")
  currency   String   @default("BRL") @db.Char(3)
  active     Boolean  @default(true)
  sort       Int      @default(0)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("credit_packages")
}

model Payment {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @map("user_id") @db.Uuid
  provider          String        @db.Text
  providerPaymentId String?       @map("provider_payment_id") @db.Text
  method            PaymentMethod
  amountCents       Int           @map("amount_cents")
  credits           Int
  status            PaymentStatus @default(pending)
  pixQrCode         String?       @map("pix_qr_code") @db.Text
  pixExpiresAt      DateTime?     @map("pix_expires_at") @db.Timestamptz(6)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(6)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  profile           Profile       @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
  @@index([provider, providerPaymentId])
  @@map("payments")
}

model WebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider        String    @db.Text
  providerEventId String    @unique @map("provider_event_id") @db.Text
  payload         Json
  signatureValid  Boolean   @map("signature_valid")
  processedAt     DateTime? @map("processed_at") @db.Timestamptz(6)
  receivedAt      DateTime  @default(now()) @map("received_at") @db.Timestamptz(6)

  @@map("webhook_events")
}

model AdminAuditLog {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  adminUserId  String   @map("admin_user_id") @db.Uuid
  targetUserId String?  @map("target_user_id") @db.Uuid
  action       String   @db.Text
  payload      Json
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  admin        Profile  @relation("AdminActions", fields: [adminUserId], references: [id], onDelete: Restrict)
  target       Profile? @relation("AuditTargets", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([adminUserId, createdAt])
  @@index([targetUserId, createdAt])
  @@map("admin_audit_log")
}
